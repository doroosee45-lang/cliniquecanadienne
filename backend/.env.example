NODE_ENV=development
PORT=5000
MONGO_URI=mongodb://127.0.0.1:27017/medisync
JWT_SECRET=change_this_to_a_very_long_random_secret_string_min_64_chars
JWT_EXPIRE=7d
JWT_COOKIE_EXPIRE=7
CLIENT_URL=http://localhost:5173
UPLOAD_MAX_MB=10
# Doit correspondre au VITE_GOOGLE_CLIENT_ID du frontend — utilisé côté
# serveur (T3.2) pour vérifier l'audience des jetons Google OAuth reçus.
GOOGLE_CLIENT_ID=xxxx.apps.googleusercontent.com
# Mot de passe utilisé par seed.js pour créer les comptes de démo (jamais en production)
SEED_PASSWORD=change_this_local_dev_seed_password
# Rapport hebdomadaire IA (utils/openai.js) — absent en dev : mode simulé, aucun envoi réel.
OPENAI_API_KEY=sk-xxxx
# SMS patients (utils/sms.js) — absent en dev : mode simulé, aucun SMS réel envoyé.
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_PHONE_NUMBER=+15005550006
# Email transactionnel (utils/mail.js, API Resend) — absent en dev : mode
# simulé, aucun email réel envoyé. Clé API Resend (https://resend.com),
# jamais un identifiant SMTP — ce projet n'utilise plus SMTP/Gmail.
# RESEND_API_KEY=re_xxxxxxxxxxxx
# Adresse expéditrice affichée sur les emails envoyés par Resend — doit
# appartenir à un domaine vérifié sur le compte Resend en production.
# MAIL_FROM="Clinique Canadienne de Souanke" <onboarding@resend.dev>
# Photos patients/personnel et pièces jointes (middleware/upload.js) — via
# Cloudinary (https://cloudinary.com), livraison signée/authenticated
# (SEC-CLOUDINARY-01) : jamais une URL publique devinable pour des données
# sensibles (photos patientes, imagerie, messagerie médicale). Absent en
# dev : repli sur le stockage disque local (backend/uploads/), jamais un
# faux succès d'upload.
# CLOUDINARY_CLOUD_NAME=xxxx
# CLOUDINARY_API_KEY=xxxxxxxxxxxxxxx
# CLOUDINARY_API_SECRET=xxxxxxxxxxxxxxxxxxxxxxxxxxx
# Bootstrap/rotation du compte superadmin initial (utils/ensureInitialAdmin.js)
# — jamais utilisé par seed.js, sûr à exécuter en production. Ne mettez la
# vraie valeur que dans les variables d'environnement du service (Render),
# jamais ici ni dans aucun fichier versionné.
INITIAL_ADMIN_EMAIL=admin@example.com
INITIAL_ADMIN_PASSWORD=change_this_strong_password
# Suivi d'erreurs (T9.10, utils/logger.js) — absent en dev : Sentry désactivé,
# aucun envoi réel. Un vrai DSN Sentry a la forme
# https://<clé>@<org>.ingest.sentry.io/<projet> — jamais une clé d'un autre
# service (ex. New Relic) placée ici par erreur : logger.js validerait un tel
# format sans le rejeter à la construction, mais Sentry lui-même refuse
# ensuite silencieusement toute requête ("Invalid Sentry Dsn"), désactivant
# le suivi sans avertissement clair.
# SENTRY_DSN=https://examplePublicKey@o0.ingest.sentry.io/0
